APP_ENV=dev
HTTP_ADDR=:8080
JWT_SECRET=replace-with-at-least-32-random-characters
# Comma-separated browser origins only. Leave empty for same-origin admin and miniapp traffic.
CORS_ALLOW_ORIGINS=

MYSQL_DSN=campus:campus@tcp(127.0.0.1:3306)/campus_circle?charset=utf8mb4&parseTime=True&loc=Local
# When ENABLE_USER_NOTIFICATIONS=true, explicitly append time_zone matching the
# verified existing DATETIME storage clock: UTC => &time_zone=%27%2B00%3A00%27;
# Asia/Shanghai (or Local on an Asia/Shanghai host) => &time_zone=%27%2B08%3A00%27.
# Do not change loc or historical values; DST/system/named time_zone is rejected.
TENCENT_IM_SDK_APP_ID=
TENCENT_IM_SECRET_KEY=
TENCENT_IM_ADMIN_USER=administrator
TENCENT_IM_REST_ENDPOINT=https://console.tim.qq.com

MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=replace-with-at-least-16-random-characters
MEILI_INDEX=products

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=campus-media-1234567890
COS_REGION=ap-guangzhou
# Enable only after migration 047 and COS CI video-info + video/audio review acceptance.
ENABLE_POST_VIDEO=false
VIDEO_REVIEW_BIZ_TYPE=
COS_APP_ID=1234567890
MEDIA_PUBLIC_BASE_URL=https://api.example.com
WECHAT_CALLBACK_TOKEN=replace-with-at-least-16-random-characters
WECHAT_API_BASE=https://api.weixin.qq.com

WECHAT_APP_ID=wx065d8f3ce4a056ee
WECHAT_APP_SECRET=
ALLOW_MOCK_WECHAT_LOGIN=false
# User notifications are fail-closed. Keep both switches false until a real
# template, authorized test account and controlled test window exist.
ENABLE_WECHAT_SUBSCRIBE_NOTIFICATIONS=false
ENABLE_USER_NOTIFICATIONS=false
# Notification deep-link release target: formal (default), trial or developer.
# Set trial only for a controlled experience-version acceptance window.
WECHAT_SUBSCRIBE_MINIPROGRAM_STATE=formal
# Actual approved template IDs; keys alone are not sufficient to authorize.
WECHAT_ORDER_TEMPLATE_ID=
WECHAT_MESSAGE_TEMPLATE_ID=
# Reviewed mapping of actual template fields to orderId/status/time. No default mapping.
WECHAT_ORDER_TEMPLATE_FIELDS=
WECHAT_MESSAGE_TEMPLATE_FIELDS=
# Restricted rollout allowlist. Empty means no external recipient is eligible.
NOTIFICATION_TEST_USER_IDS=
ENABLE_NOTIFICATION_SENDING=false
WECHAT_ORDER_TEMPLATE_KEY=
WECHAT_MESSAGE_TEMPLATE_KEY=
NOTIFICATION_IM_CALLBACK_TOKEN=

# WeChat Pay / G-4 payment scaffold.
# Leave these empty until a real merchant account is available.
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_PLATFORM_KEY_ID=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
ALLOW_MOCK_PAYMENT=false

# Legacy platform takeout is archived and fail-closed by default.
ENABLE_LEGACY_TAKEOUT=false
# Reserved for the Delivery domain starting at D-1.
ENABLE_DELIVERY=true
# Local-only feature visibility center; must remain false in production.
ENABLE_FEATURE_POLICY=true
# D-3 delivery funds routes are fail-closed until explicitly enabled.
ENABLE_DELIVERY_PAYMENT=false
# Internal rider payout queue only. This reserves verified earnings but never calls WeChat transfer.
# Keep disabled until migration 050 is applied and the isolated concurrency suite passes.
ENABLE_DELIVERY_RIDER_PAYOUT_QUEUE=false
# T+1 internal ledger credit only; no provider transfer. Apply migration 054
# with money writers stopped, reconcile historical balances, then opt in.
ENABLE_DELIVERY_RIDER_DAILY_SETTLEMENT=false
# Local-only bridge until D-3 real delivery-fee payment is available.
ALLOW_MOCK_DELIVERY_FEE_CONFIRMATION=false
# D-3 mock exercises real wallet/payment/refund facts and is never allowed in production.
ALLOW_MOCK_DELIVERY_PAYMENT=false
DELIVERY_WECHAT_PAY_NOTIFY_URL=
DELIVERY_WECHAT_REFUND_NOTIFY_URL=
# Optional enterprise WeChat rider-group robot URL. Keep the key secret.
WECOM_RIDER_WEBHOOK_URL=
