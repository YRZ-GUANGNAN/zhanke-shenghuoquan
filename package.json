{
  "name": "campus-circle",
  "version": "0.1.0",
  "private": true,
  "description": "Campus community, second-hand marketplace, mini-program navigation, and admin system.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:miniapp": "npm --workspace apps/miniapp run dev:weapp",
    "dev:api": "npm run dev:mock-api",
    "dev:mock-api": "node scripts/dev-api.cjs",
    "dev:backend": "cd backend && go run ./cmd/server",
	"dev:infra": "docker compose -f deploy/docker-compose.yml up mysql",
    "dev:stack": "docker compose -f deploy/docker-compose.yml up --build",
    "db:seed": "node scripts/seed-db.cjs",
    "check:stack": "node scripts/check-stack.cjs",
    "check:boundaries": "node scripts/check-boundaries.cjs",
    "check:external-takeout-directory": "node scripts/check-external-takeout-directory.cjs",
    "check:miniapp-domain-search": "node scripts/check-miniapp-domain-search.cjs",
		"check:miniapp-settings-contract": "node scripts/check-miniapp-settings-contract.cjs",
    "check:identity-application-contract": "node scripts/check-identity-application-contract.cjs",
    "check:admin-password-session-contract": "node scripts/check-admin-password-session-contract.cjs",
    "check:miniapp-capsule-layout": "node scripts/check-miniapp-capsule-layout.cjs",
    "check:merchant-home-clarity": "node scripts/check-merchant-home-clarity.cjs",
    "check:rider-workbench-clarity": "node scripts/check-rider-workbench-clarity.cjs",
    "check:home-real-tools-contract": "node scripts/check-home-real-tools-contract.cjs",
    "check:real-wechat-secret-hygiene": "node scripts/check-real-wechat-secret-hygiene.cjs",
    "check:miniapp-publish-contract": "node scripts/check-miniapp-publish-contract.cjs",
    "check:miniapp-static-routes": "node scripts/check-miniapp-static-routes.cjs",
    "check:miniapp-business-closure": "node scripts/check-miniapp-business-closure.cjs",
    "test:backend": "cd backend && go test ./...",
    "build:miniapp": "npm --workspace apps/miniapp run build:weapp",
    "dev:admin": "npm --workspace apps/admin run dev",
    "build:admin": "npm --workspace apps/admin run build",
    "build": "npm run build:miniapp && npm run build:admin",
    "typecheck": "npm --workspace apps/admin run typecheck && npm --workspace apps/miniapp run typecheck",
	"verify": "npm run check:external-takeout-directory && npm run check:miniapp-static-routes && npm run check:miniapp-business-closure && npm run check:boundaries && npm run check:miniapp-publish-contract && npm run check:miniapp-domain-search && npm run check:miniapp-settings-contract && npm run check:identity-application-contract && npm run check:miniapp-capsule-layout && npm run check:home-real-tools-contract && npm run check:real-wechat-secret-hygiene && npm run check:merchant-home-clarity && npm run check:rider-workbench-clarity && npm run typecheck && npm run test:backend"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@swc/core": "1.3.96",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "^5.4.5",
    "vite": "8.0.16"
  },
  "overrides": {
    "@swc/core": "1.3.96",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
